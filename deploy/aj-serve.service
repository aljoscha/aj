[Unit]
Description=aj session host
Documentation=https://github.com/aljoscha/aj

# A user unit cannot order itself against system units, so there is no
# After=network-online.target or After=tailscaled.service here even though
# this needs both. Restart=on-failure covers it: early starts after a boot
# fail closed and retry until the network and the tailscale daemon are up.

[Service]
Type=simple

# One host serves one working directory (spec section 4) and its session
# store is keyed to it. %h is your home directory, so a repo kept under
# it gets a store named for its path relative to home (~/projects/api
# becomes projects-api), which is what keeps two checkouts apart.
WorkingDirectory=%h/projects/api

# The control port runs arbitrary commands through the agent, so it is
# never served unauthenticated. `tailscale` verifies each peer against the
# local daemon and admits only the logins named in AJ_ALLOW, or a tagged
# node granted github.com/aljoscha/aj/cap/control in the tailnet policy
# (spec section 6.11).
#
# `open` belongs only to a network that is private by construction, such
# as an ember guest reachable from its hypervisor and nowhere else
# (spec section 7.4). A machine you can ssh into is not that.
#
# The conservative alternative is to drop AJ_AUTH and AJ_ALLOW, leave
# AJ_LISTEN at its loopback default, and reach the host through an ssh
# tunnel. That trades the tailnet dependency for a hop.
Environment=AJ_LISTEN=0.0.0.0:6161
Environment=AJ_AUTH=tailscale
Environment=AJ_ALLOW=you@github

ExecStart=%h/.local/bin/aj serve

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
