[Unit]
Description=aj gateway
Documentation=https://github.com/aljoscha/aj

# As with the host unit: no ordering against system units is available to
# a user unit, so Restart=on-failure is what gets this up after a boot.

[Service]
Type=simple

# A gateway holds no session logs and no working directory of its own
# (spec section 7.1). Its state is the enrolled set, under ~/.aj.
WorkingDirectory=%h

# Same rule as a host: the gateway proxies commands to hosts that run
# them, so an unauthenticated gateway is an unauthenticated host
# (spec section 6.11).
Environment=AJ_LISTEN=0.0.0.0:6160
Environment=AJ_AUTH=tailscale
Environment=AJ_ALLOW=you@github

# Static hosts come from `~/.aj/gateway.toml` when that file exists, and a
# gateway told about its hosts over /v1/hosts needs no file at all. No
# --config here on purpose: naming a file explicitly makes it required, so
# a --config pointing at one that is not written yet is a hard failure,
# and with Restart=on-failure that is a restart loop rather than a message.
# Enrollments persist under ~/.aj/gateway/ either way.
ExecStart=%h/.local/bin/aj gateway

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
